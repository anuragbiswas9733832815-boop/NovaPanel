# Copy to apps/api/.env. The development database is loopback-only; replace its password outside local development.
DATABASE_URL="postgresql://nova:nova-local-only-change-me@127.0.0.1:5432/nova?schema=public"
# The API prestart/predev hook replaces these placeholders once and preserves the generated keys.
JWT_SECRET="replace-on-first-start"
NODE_ENCRYPTION_KEY="replace-on-first-start"
NOVA_INSTALLER_TOKEN="replace-on-first-start"
PANEL_ORIGIN="http://localhost:3000"
# Public HTTPS origin configured for the local node agent heartbeat destination (set for VPS deployments).
NOVA_CONTROL_URL=""
# Optional HTTPS agent listener URL; node inventory and connection are not considered ready until heartbeat.
LOCAL_AGENT_URL=""
PORT=4000
HOST=0.0.0.0
# Optional comma-separated trusted reverse-proxy addresses/CIDRs; leave empty unless configured.
TRUSTED_PROXY_ADDRESSES=
NODE_ENV=development
