{
  "name": "@nova/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "node ../../scripts/ensure-api-secrets.mjs && prisma migrate deploy && prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "prestart": "node ../../scripts/ensure-api-secrets.mjs",
    "start": "prisma migrate deploy && node dist/server.js",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "pg": "^8.16.3",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
